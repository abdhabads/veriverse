{
  "manifest_version": 3,
  "name": "Verify with VeriVerse",
  "description": "Send selected text or the current page to VeriVerse for a fact-check review. Does not verify anything itself - it only opens VeriVerse with your content ready for you to review.",
  "version": "1.0.0",
  "action": {
    "default_title": "Verify with VeriVerse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
